API_URL=https://hamrofutsal.com/api
APP_NAME=Hamro Footsall
SECURE_API_TOKEN=hello

# ── Laravel Reverb (realtime chat) ──────────────────────────────────────────
# Values come from the backend's Reverb config. REVERB_APP_KEY is required and
# must match the server. Verify the host/port the Reverb server is reachable on
# publicly (often a subdomain or :443 behind TLS).
REVERB_APP_KEY=
REVERB_HOST=hamrofutsal.com
REVERB_PORT=443
REVERB_SCHEME=https
# Laravel's broadcasting auth route. Confirm whether it's at the app root or
# under /api with your token guard.
REVERB_AUTH_URL=https://hamrofutsal.com/broadcasting/auth
# Event names the backend broadcasts. Adjust to match your broadcast event's
# broadcastAs() (Laravel may prefix a leading dot — the client tolerates both).
REVERB_MESSAGE_EVENT=message.sent
REVERB_TYPING_EVENT=typing