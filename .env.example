# Copy this file to `.env` and fill in real values. `.env` is gitignored.

API_URL=https://your-api-host/api
APP_NAME=Hamro Futsal
SECURE_API_TOKEN=

# OSRM-compatible routing server used for driving-road distances. For
# production, use a managed endpoint or your own OSRM instance.
ROUTING_API_URL=https://router.project-osrm.org

# ── Laravel Reverb (realtime chat) ──────────────────────────────────────────
REVERB_APP_KEY=
REVERB_HOST=
REVERB_PORT=
REVERB_SCHEME=
REVERB_AUTH_URL=
REVERB_MESSAGE_EVENT=message.sent
REVERB_TYPING_EVENT=typing
REVERB_STOP_TYPING_EVENT=stop-typing
REVERB_READ_EVENT=messages.read
# Realtime booking channels. Optional overrides; placeholders are substituted at
# runtime. Use Laravel channel names here; Flutter adds private-/presence- for
# the Pusher subscription.
REVERB_SLOT_CHANNEL=venue.{venueId}.slots
REVERB_BOOKING_CHANNEL=venue.{venueId}.booking.{bookingDate}

# ── Google Sign-In ──────────────────────────────────────────────────────────
# Web (server) OAuth client id: google-services.json -> oauth_client "client_type": 3
GOOGLE_SERVER_CLIENT_ID=
# iOS OAuth client id: GoogleService-Info.plist -> CLIENT_ID ("client_type": 2)
GOOGLE_IOS_CLIENT_ID=
